; Copy to fpl-agent.ini and fill in. That filename is gitignored.
;
;   cp fpl-agent.ini.example fpl-agent.ini && chmod 600 fpl-agent.ini
;
; Every setting here is an alternative to the matching environment variable, and the
; environment always wins - so a scheduled run can override the file without editing it.
; The password is stored in plaintext, so keep the file owner-readable only.
;
; For an unattended server, see docs/SCHEDULING.md.

[auth]
; Restore a cached session at startup, else log in with the credentials below.
auto_login = true
email =
password =
; Refuse make_transfers. Recommended for anything unattended: the cached token is a
; bearer credential that can execute transfers on your account.
read_only = true
; Where the session and its refresh token are cached. Put this somewhere persistent
; on a server. The file rotates on every refresh, so restoring an old copy of it
; restores a dead token - back up the location, not the content.
; token_cache = ~/.config/fpl-mcp/session.json
; The OAuth endpoint and client id the refresh grant uses. Set only if the login
; breaks because the account service changed them; the defaults are in headless_auth.
; token_endpoint = https://account.premierleague.com/as/token
; client_id =

[rivals]
; League ids to measure ownership against, comma-separated.
; Leave empty to use every private league under the rival cap.
leagues =

[brief]
; The net expected-points bar a transfer has to clear before `notify` will interrupt
; you for it, over the 3-gameweek horizon. Default 2.0. Raise it if the pushes feel
; like noise; lower it only once `settle` has graded enough gameweeks to say what a
; 2-point edge is actually worth.
; min_net_xp = 2.0

[notify]
; Push notifications over ntfy (https://ntfy.sh). No account is needed - the topic IS
; the address.
;
; THE TOPIC IS A SHARED SECRET. ntfy has no authentication: anyone who knows or guesses
; your topic can subscribe to it and read every message it carries - your squad, your
; transfers, when you are about to act. So do not use "fpl", your name, or anything
; anyone would try. Use a long random string and treat it like a password:
;
;   ntfy_topic = $(python3 -c "import secrets; print('fpl-' + secrets.token_urlsafe(24))")
;
; Then subscribe to that exact topic in the ntfy app on your phone. Leave it empty and
; `fpl-agent notify` exits 2 and sends nothing; `notify --dry-run` still works without
; one, and prints what would have been sent.
ntfy_topic =
; A self-hosted ntfy instance, if you would rather not post to the public one. The topic
; is still a secret there unless you have put access control in front of it.
; ntfy_server = https://ntfy.sh

[server]
; transport = stdio
; auth_port = 8020
