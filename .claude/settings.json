{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git merge-base:*)",
      "Bash(git branch --show-current)",

      "Bash(make test)",
      "Bash(.venv/bin/fpl-agent status:*)",
      "Bash(.venv/bin/fpl-agent project:*)",
      "Bash(.venv/bin/fpl-agent recommend:*)",

      "Bash(sqlite3 -readonly:*)"
    ],
    "deny": [
      "Read(./fpl-agent.ini)",
      "Read(./*.ini)",
      "Read(./session.json)",
      "Read(./.fpl-session.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/test-before-commit.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
