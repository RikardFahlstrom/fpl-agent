__pycache__
*.py[cod]
*.pyo
*.pyd
*.db
*.sqlite
*.log
*.pot
*.pyc
*.pdb
*.egg-info/
dist/
build/

# Cached FPL session token - an account credential, never commit it
session.json
.fpl-session.json

# Local settings, including credentials in plaintext. Ignore every ini except the
# template, so a differently-named copy cannot be committed by accident.
*.ini
!*.ini.example

# Scratch checkouts made by subagents. Derived and disposable, like data/fpl.db:
# each is a full copy of the tree on its own branch, and the work that matters is
# merged back before the worktree is dropped. The rest of .claude/ is committed.
.claude/worktrees/
